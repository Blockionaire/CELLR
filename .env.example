# Copy to apps/web/.env.local for local development. Never commit real values.
# Production values live in Vercel project settings.

# --- Supabase (Project Settings → API Keys) -------------------------------------------------
# Safe to expose to the browser: the publishable key is gated by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. Bypasses RLS. Used solely in src/server/privileged. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (server only) --------------------------------------------------------------------
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint.
# AI_BASE_URL=
# Model ids are configuration (all default to gpt-6-luna): label photos, valuations (and the advice fallback).
# AI_MODEL_VISION=
# AI_MODEL_CHAT=
# Optional: Sommelier, Tonight and wine profiles only. Unset = AI_MODEL_CHAT.
# AI_MODEL_ADVICE=
# Optional, only for models with a documented effort (gpt-6-luna): none (default), low or medium.
# AI_REASONING_EFFORT=
