{
  "name": "cellr",
  "private": true,
  "version": "0.0.0",
  "description": "CELLR — your personal intelligent wine cellar",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @cellr/web dev",
    "build": "pnpm --filter @cellr/web build",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:test": "bash scripts/db-test.sh",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:test",
    "db:types": "bash scripts/db-types.sh",
    "db:types:check": "bash scripts/db-types.sh --check",
    "architecture:inventory": "node apps/web/scripts/architecture/inventory.mjs",
    "architecture:impact": "node apps/web/scripts/architecture/impact.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "splash": "node scripts/generate-splash.mjs",
    "offline-page": "node scripts/generate-offline.mjs",
    "e2e": "pnpm --filter @cellr/web e2e",
    "scan:eval": "pnpm --filter @cellr/scan-eval start",
    "sommelier:eval": "pnpm --filter @cellr/sommelier-eval run --silent start",
    "db:test:budget": "bash scripts/db-budget-concurrency.sh",
    "db:test:imports": "bash scripts/db-import-concurrency.sh",
    "db:test:claims": "bash scripts/db-claim-concurrency.sh",
    "db:test:placement": "bash scripts/db-placement-concurrency.sh",
    "db:test:shared-racks": "bash scripts/db-shared-racks-concurrency.sh",
    "db:test:upgrade": "bash scripts/db-smart-cellar-upgrade.sh",
    "migrations:check": "bash scripts/check-migration-immutability.sh origin/main",
    "migrations:check:test": "bash scripts/check-migration-immutability.test.sh",
    "storage-backup": "pnpm --filter @cellr/storage-backup run --silent cli"
  },
  "devDependencies": {
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "supabase": "2.120.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  }
}
